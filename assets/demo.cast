[1.432232, "o", "\r\n\u001b[1mcaliper v0.4.0\u001b[0m\u001b[2m · development environment audit\u001b[0m\r\n\u001b[33m\u001b[1mSYNTHETIC DEMONSTRATION DATA — fabricated sessions, not your data.\u001b[0m\u001b[0m\r\n\u001b[2mgenerated 2026-01-15 17:00 UTC · window: last 1d 8h · limit 50/agent\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mENVIRONMENT\u001b[0m\r\n  \u001b[32m●\u001b[0m \u001b[1mopencode \u001b[0m v2.3.1 (demo) · sqlite-v2 · 4 sessions\r\n  \u001b[32m●\u001b[0m \u001b[1mcodex    \u001b[0m v0.169.0 (demo) · jsonl-rollout · 2 sessions\r\n  \u001b[32m●\u001b[0m \u001b[1mclaude   \u001b[0m v2.1.327 (demo) · jsonl-projects · 2 sessions\r\n\u001b[2m  configs: 0 · MCP servers: 3 · skills: 4 · instruction files: 2\u001b[0m\r\n\r\n\u001b[1mCOVERAGE\u001b[0m\r\n  sessions discovered 8 · analyzed 8 · from cache 0\r\n\u001b[2m  skipped: 0 outside window, 0 over limit, 0 failed reads · partial parses: 0\u001b[0m\r\n\r\n\u001b[1mUSAGE TOTALS\u001b[0m\u001b[2m (analyzed sessions)\u001b[0m\r\n  tokens: input 25.2k · output 8.4k · reasoning 2.1k · cache read 168.0k · cache write 4.2k\r\n  reported cost: $0.08 · tool calls: 31 (11 errors) · turns: 8 user / 23 assistant\r\n  subagents (sidechains): 1 turn · 1 tool call (0 errors)\r\n\r\n\u001b[1mFINDINGS (13)\u001b[0m\u001b[2m  high 2 · medium 6 · low 5\u001b[0m\r\n\r\n  \u001b[31m\u001b[1m[HIGH]\u001b[0m\u001b[0m \u001b[1m1 secret-looking value(s) stored in plaintext config\u001b[0m\r\n\u001b[2m         rule plaintext-config-secrets · confidence high · scope environment\u001b[0m\r\n"]
