{
  "name": "havrin",
  "version": "0.3.0",
  "description": "Local-first, evidence-driven optimization engine for AI-powered development. Analyze coding-agent sessions, diagnose workflow inefficiencies, and get evidence-backed recommendations.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "havrin": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage test/",
    "lint": "tsc -p tsconfig.json --noEmit",
    "havrin": "node --experimental-strip-types src/cli.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "opencode",
    "codex",
    "developer-tools",
    "optimization",
    "cli",
    "local-first",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouion/havrin.git"
  },
  "homepage": "https://github.com/vouion/havrin#readme",
  "bugs": {
    "url": "https://github.com/vouion/havrin/issues"
  },
  "author": "Gavin Schiller",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/vouion"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://buymeacoffee.com/vouion"
    }
  ],
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
